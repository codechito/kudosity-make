[
	{
		"condition": "{{parameters.content_type = 'text'}}",
		"url": "/rcs/messages",
		"method": "POST",
		"headers": {
			"User-Agent": "kudosity-make/0.1.0",
			"X-Kudosity-Source": "kudosity-make",
			"X-Kudosity-Source-Version": "0.1.0",
			"X-Kudosity-Action": "rcs.send"
		},
		"body": {
			"sender": "{{parameters.sender}}",
			"recipient": "{{parameters.recipient}}",
			"content_type": "text",
			"content": {
				"text": {
					"message": "{{parameters.message}}"
				}
			},
			"message_ref": "{{parameters.message_ref}}",
			"sms_fallback": "{{parameters.sms_fallback}}"
		},
		"response": {
			"output": {
				"id": "{{body.id}}",
				"message_ref": "{{body.message_ref}}",
				"sender": "{{body.sender}}",
				"recipient": "{{body.recipient}}",
				"recipient_country": "{{body.recipient_country}}",
				"content_type": "{{body.content_type}}",
				"content": "{{body.content}}",
				"sms_fallback": "{{body.sms_fallback}}",
				"created_at": "{{parseDate(body.created_at)}}"
			}
		}
	},
	{
		"condition": "{{parameters.content_type = 'media'}}",
		"url": "/rcs/messages",
		"method": "POST",
		"headers": {
			"User-Agent": "kudosity-make/0.1.0",
			"X-Kudosity-Source": "kudosity-make",
			"X-Kudosity-Source-Version": "0.1.0",
			"X-Kudosity-Action": "rcs.send"
		},
		"body": {
			"sender": "{{parameters.sender}}",
			"recipient": "{{parameters.recipient}}",
			"content_type": "media",
			"content": {
				"media": {
					"file_url": "{{parameters.file_url}}"
				}
			},
			"message_ref": "{{parameters.message_ref}}",
			"sms_fallback": "{{parameters.sms_fallback}}"
		},
		"response": {
			"output": {
				"id": "{{body.id}}",
				"message_ref": "{{body.message_ref}}",
				"sender": "{{body.sender}}",
				"recipient": "{{body.recipient}}",
				"recipient_country": "{{body.recipient_country}}",
				"content_type": "{{body.content_type}}",
				"content": "{{body.content}}",
				"sms_fallback": "{{body.sms_fallback}}",
				"created_at": "{{parseDate(body.created_at)}}"
			}
		}
	}
]
