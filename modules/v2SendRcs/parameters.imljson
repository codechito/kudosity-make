[
	{
		"name": "sender",
		"type": "text",
		"label": "Sender",
		"required": true,
		"help": "RCS agent registered with Kudosity."
	},
	{
		"name": "recipient",
		"type": "text",
		"label": "Recipient",
		"required": true,
		"help": "Destination number in international format, e.g. 61412345678."
	},
	{
		"name": "content_type",
		"type": "select",
		"label": "Content Type",
		"required": true,
		"default": "text",
		"options": [
			{
				"label": "Text",
				"value": "text",
				"nested": [
					{
						"name": "message",
						"type": "text",
						"label": "Message",
						"required": true,
						"multiline": true
					}
				]
			},
			{
				"label": "Image or Video",
				"value": "media",
				"nested": [
					{
						"name": "file_url",
						"type": "url",
						"label": "File URL",
						"required": true,
						"help": "Publicly reachable URL of one image or video."
					}
				]
			}
		]
	},
	{
		"name": "message_ref",
		"type": "text",
		"label": "Message Reference",
		"help": "Your own reference, echoed back on status webhooks. Useful for matching a send to its delivery receipt."
	},
	{
		"name": "sms_fallback",
		"type": "collection",
		"label": "SMS Fallback",
		"help": "Send an SMS instead if this message cannot be delivered.",
		"spec": [
			{
				"name": "sender",
				"type": "text",
				"label": "Fallback Sender",
				"help": "SMS sender ID or virtual number."
			},
			{
				"name": "message",
				"type": "text",
				"label": "Fallback Message",
				"multiline": true
			}
		]
	}
]
