[
	{
		"name": "to",
		"type": "text",
		"label": "To",
		"required": true,
		"help": "Recipient number. Combine with Country Code for local-format numbers."
	},
	{
		"name": "message",
		"type": "text",
		"label": "Message",
		"required": true,
		"multiline": true,
		"help": "Message text. Use [opt-out-link] to insert an opt-out link and [tracked-link] for the tracked link."
	},
	{
		"name": "from",
		"type": "text",
		"label": "From",
		"help": "Sender ID or virtual number. Leave blank to use the account default."
	},
	{
		"name": "countrycode",
		"type": "text",
		"label": "Country Code",
		"help": "Two-letter country code, used to expand local-format numbers (e.g. AU)."
	},
	{
		"name": "tracked_link_url",
		"type": "url",
		"label": "Tracked Link URL",
		"help": "URL to shorten and track. Put [tracked-link] in the message where it should appear."
	},
	{
		"name": "validity",
		"type": "uinteger",
		"label": "Validity (Minutes)",
		"help": "Give up on delivery after this many minutes. Leave blank to let the carrier decide."
	},
	{
		"name": "send_at",
		"type": "date",
		"label": "Send At",
		"help": "Schedule the message for later. Leave blank to send now."
	},
	{
		"name": "dlr_callback",
		"type": "url",
		"label": "Delivery Receipt Callback URL",
		"help": "Where delivery receipts are POSTed."
	},
	{
		"name": "reply_callback",
		"type": "url",
		"label": "Reply Callback URL",
		"help": "Where replies to this message are POSTed. A **Watch Inbound SMS (V1)** trigger receives these."
	},
	{
		"name": "link_hits_callback",
		"type": "url",
		"label": "Link Hits Callback URL",
		"help": "Where tracked-link clicks are POSTed."
	}
]
