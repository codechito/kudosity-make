{
	"url": "https://api.transmitsms.com{{parameters.url}}",
	"method": "{{parameters.method}}",
	"headers": {
		"Authorization": "Basic {{base64(connection.apiKey + ':' + connection.apiSecret)}}",
		"Accept": "application/json",
		"User-Agent": "kudosity-make/0.1.0",
		"X-Kudosity-Source": "kudosity-make",
		"X-Kudosity-Source-Version": "0.1.0",
		"X-Kudosity-Action": "api.call",
		"{{...}}": "{{toCollection(parameters.headers, 'key', 'value')}}"
	},
	"qs": {
		"{{...}}": "{{toCollection(parameters.qs, 'key', 'value')}}"
	},
	"body": "{{parameters.body}}",
	"type": "urlencoded",
	"response": {
		"output": {
			"body": "{{body}}",
			"headers": "{{headers}}",
			"statusCode": "{{statusCode}}"
		},
		"error": {
			"message": "{{kudosityError(body, statusCode, 'v1')}}"
		}
	}
}
