{
	"url": "https://api.transmitsms.com/get-sms-delivery-status.json",
	"method": "GET",
	"headers": {
		"Authorization": "Basic {{base64(connection.apiKey + ':' + connection.apiSecret)}}",
		"Accept": "application/json",
		"User-Agent": "kudosity-make/0.1.0",
		"X-Kudosity-Source": "kudosity-make",
		"X-Kudosity-Source-Version": "0.1.0",
		"X-Kudosity-Action": "status.get"
	},
	"qs": {
		"message_id": "{{parameters.message_id}}",
		"msisdn": "{{parameters.msisdn}}"
	},
	"response": {
		"output": {
			"message_id": "{{body.message_id}}",
			"sender_id": "{{body.sender_id}}",
			"mobile": "{{body.mobile}}",
			"send_at": "{{parseDate(body.send_at, 'YYYY-MM-DD HH:mm:ss', 'UTC')}}",
			"datetime": "{{parseDate(body.datetime, 'YYYY-MM-DD HH:mm:ss', 'UTC')}}",
			"message": "{{body.message}}",
			"status": "{{body.status}}"
		},
		"error": {
			"message": "{{kudosityError(body, statusCode, 'v1')}}"
		}
	}
}
