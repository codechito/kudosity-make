{
	"url": "https://api.transmitsms.com/get-sender-ids.json",
	"method": "GET",
	"headers": {
		"Authorization": "Basic {{base64(connection.apiKey + ':' + connection.apiSecret)}}",
		"Accept": "application/json",
		"User-Agent": "kudosity-make/0.1.0",
		"X-Kudosity-Source": "kudosity-make",
		"X-Kudosity-Source-Version": "0.1.0",
		"X-Kudosity-Action": "senderids.get"
	},
	"response": {
		"output": {
			"virtual_numbers": "{{get(body.result.caller_ids, 'Virtual Number')}}",
			"business_names": "{{get(body.result.caller_ids, 'Business Name')}}",
			"mobile_numbers": "{{get(body.result.caller_ids, 'Mobile Number')}}"
		},
		"error": {
			"message": "{{kudosityError(body, statusCode, 'v1')}}"
		}
	}
}
