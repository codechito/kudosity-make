{
  "name": "kudosity-make",
  "version": "0.1.0",
  "private": true,
  "description": "Make custom app for the Kudosity messaging API",
  "scripts": {
    "test": "node --test test/*.test.js",
    "validate": "node -e \"require('fs').readdirSync('.',{recursive:true}).filter(f=>f.endsWith('.imljson')).forEach(f=>{try{JSON.parse(require('fs').readFileSync(f))}catch(e){console.error('INVALID',f,e.message);process.exit(1)}});console.log('all imljson parse')\"",
    "deploy:plan": "node scripts/deploy.js",
    "deploy": "node scripts/deploy.js --apply",
    "smoke": "node scripts/smoke-test.js",
    "smoke:learn": "node scripts/smoke-test.js --learn",
    "review": "node scripts/review-scenarios.js"
  },
  "license": "MIT"
}
