{
	"url": "https://api.transmitsms.com/get-client.json",
	"method": "GET",
	"headers": {
		"Authorization": "Basic {{base64(parameters.apiKey + ':' + parameters.apiSecret)}}",
		"Accept": "application/json",
		"User-Agent": "kudosity-make/0.1.0",
		"X-Kudosity-Source": "kudosity-make",
		"X-Kudosity-Source-Version": "0.1.0",
		"X-Kudosity-Action": "connect"
	},
	"response": {
		"error": {
			"message": "{{kudosityError(body, statusCode, 'v1')}}"
		}
	},
	"log": {
		"sanitize": [
			"request.headers.authorization"
		]
	}
}
