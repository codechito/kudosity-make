{
	"url": "https://api.transmitsms.com/get-client.json",
	"method": "GET",
	"headers": {
		"Authorization": "Basic {{base64(parameters.apiKey + ':' + parameters.apiSecret)}}",
		"Accept": "application/json"
	},
	"response": {
		"error": {
			"message": "[{{statusCode}}] {{ifempty(body.error.description, body.error.message, body.error, 'Kudosity rejected these v1 credentials')}}. v1 needs both the API key and its secret \u2014 check Settings > API in your account."
		}
	},
	"log": {
		"sanitize": [
			"request.headers.authorization"
		]
	}
}
