{
	"url": "https://api.transmitsms.com/get-client.json",
	"method": "GET",
	"headers": {
		"Authorization": "Basic {{base64(parameters.apiKey + ':' + parameters.apiSecret)}}",
		"Accept": "application/json"
	},
	"response": {
		"error": {
			"message": "{{kudosityError(body, statusCode, 'v1')}}"
		}
	},
	"log": {
		"sanitize": [
			"request.headers.authorization"
		]
	}
}
