{
	"url": "https://api.transmitmessage.com/v2/sms",
	"method": "GET",
	"qs": {
		"limit": 1
	},
	"headers": {
		"x-api-key": "{{parameters.apiKey}}",
		"User-Agent": "kudosity-make/0.1.0",
		"X-Kudosity-Source": "kudosity-make",
		"X-Kudosity-Source-Version": "0.1.0",
		"X-Kudosity-Action": "connect"
	},
	"response": {
		"error": {
			"message": "{{kudosityError(body, statusCode, 'v2')}}"
		}
	},
	"log": {
		"sanitize": [
			"request.headers.x-api-key"
		]
	}
}
