{
	"url": "https://api.transmitmessage.com/v2/sms",
	"method": "GET",
	"qs": {
		"limit": 1
	},
	"headers": {
		"x-api-key": "{{parameters.apiKey}}"
	},
	"response": {
		"error": {
			"message": "[{{statusCode}}] {{ifempty(body.status, body.error.message, 'Kudosity rejected the API key')}}. Check Settings > API in your Kudosity account."
		}
	},
	"log": {
		"sanitize": [
			"request.headers.x-api-key"
		]
	}
}
