{
	"url": "/webhook",
	"method": "POST",
	"headers": {
		"x-api-key": "{{connection.apiKey}}",
		"User-Agent": "kudosity-make/0.1.0",
		"X-Kudosity-Source": "kudosity-make",
		"X-Kudosity-Source-Version": "0.1.0",
		"X-Kudosity-Action": "trigger.subscribe"
	},
	"body": {
		"name": "Make",
		"url": "{{webhook.url}}",
		"filter": {
			"event_type": "{{parameters.eventTypes}}"
		}
	},
	"response": {
		"data": {
			"webhookId": "{{body.id}}"
		}
	}
}
