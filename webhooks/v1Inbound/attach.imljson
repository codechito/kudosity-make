{
	"url": "https://api.transmitsms.com/edit-number-options.json",
	"method": "GET",
	"headers": {
		"Authorization": "Basic {{base64(connection.apiKey + ':' + connection.apiSecret)}}",
		"Accept": "application/json",
		"User-Agent": "kudosity-make/0.1.0",
		"X-Kudosity-Source": "kudosity-make",
		"X-Kudosity-Source-Version": "0.1.0",
		"X-Kudosity-Action": "trigger.subscribe"
	},
	"qs": {
		"number": "{{parameters.number}}",
		"forward_url": "{{webhook.url}}"
	},
	"response": {
		"data": {
			"registeredNumber": "{{parameters.number}}"
		},
		"error": {
			"message": "{{kudosityError(body, statusCode, 'v1')}}"
		}
	}
}
