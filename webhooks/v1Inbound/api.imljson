{
	"output": {
		"phone": "{{ifempty(query.mobile, ifempty(body.mobile, ifempty(body.msisdn, body.from)))}}",
		"id": "{{ifempty(query.message_id, ifempty(body.message_id, body.id))}}",
		"response_id": "{{ifempty(query.response_id, body.response_id)}}",
		"message": "{{ifempty(query.response, ifempty(body.response, body.message))}}",
		"status": "{{if(ifempty(query.is_optout, body.is_optout) = 'yes', 'opt-out', 'received')}}",
		"opt_out": "{{ifempty(query.is_optout, body.is_optout) = 'yes'}}",
		"to": "{{ifempty(query.longcode, ifempty(body.longcode, body.to))}}",
		"received_at": "{{parseDate(ifempty(query.datetime_entry, ifempty(body.datetime_entry, ifempty(body.datetime, body.received_at))), 'YYYY-MM-DD HH:mm:ss', 'UTC')}}",
		"raw": "{{ifempty(query, body)}}"
	},
	"respond": {
		"status": 200
	}
}
