{
	"baseUrl": "https://api.transmitmessage.com/v2",
	"headers": {
		"x-api-key": "{{connection.apiKey}}"
	},
	"response": {
		"error": {
			"message": "[{{statusCode}}] {{ifempty(body.error.description, body.error.message, body.error, body.status, body.message, body)}}"
		}
	},
	"log": {
		"sanitize": [
			"request.headers.x-api-key"
		]
	}
}
